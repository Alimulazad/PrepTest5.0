# VITE_API_BASE_URL / VITE_SERVER_URL: Public Backend API base URL (e.g. Express / Ngrok tunnel)
VITE_API_BASE_URL="https://unblessed-plexiglas-repeater.ngrok-free.dev"
VITE_SERVER_URL="https://unblessed-plexiglas-repeater.ngrok-free.dev"
VITE_SERVER_URL_FOR_ADMIN="https://unblessed-plexiglas-repeater.ngrok-free.dev"

# DATABASE_URL: PostgreSQL connection URI (e.g. postgresql://user:password@localhost:5432/jachai or Neon/Supabase URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jachai"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEYS=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Required secret key for signing user & admin authentication tokens
JWT_SECRET="jachai-admission-super-secret-jwt-key-2026"

# ADMIN_PASSWORD: Password for question bank admin dashboard
ADMIN_PASSWORD="admin"

# Rate Limiting (Optional overrides)
AUTH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=40

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=

# OPENROUTER_API_KEY: Primary API Key for OpenRouter free & premium models
OPENROUTER_API_KEY=

# OPENROUTER_API_KEYS: Comma-separated list of multiple fallback API keys for high-availability auto failover
OPENROUTER_API_KEYS=

# CLOUDINARY: Image uploads for questions and explanations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

